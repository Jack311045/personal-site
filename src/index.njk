<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#171918">
    <meta name="description" content="{{ site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ site.title }}">
    <meta property="og:description" content="{{ site.description }}">
    {% if site.url %}
      {% set canonicalUrl = site.url + page.url %}
      <link rel="canonical" href="{{ canonicalUrl }}">
      <meta property="og:url" content="{{ canonicalUrl }}">
    {% endif %}
    <title>{{ site.title }}</title>
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    <script src="{{ '/assets/js/site.js' | url }}" defer></script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="{{ '/' | url }}">Personal <span>Archive</span></a>
      <span class="header-note">my life in a nutshell</span>
    </header>
    <main>
      <section class="intro">
        <p class="eyebrow">Jack311045's</p>
        <h1>TIMELINE</h1>
        <p>Photos, places, and play — collected by the date they happened.</p>
      </section>
      <nav class="filters" aria-label="Filter timeline by category">
        <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-button" type="button" data-filter="gallery" aria-pressed="false">Gallery</button>
        <button class="filter-button" type="button" data-filter="travel" aria-pressed="false">Travel</button>
        <button class="filter-button" type="button" data-filter="food" aria-pressed="false">Food</button>
        <button class="filter-button" type="button" data-filter="games" aria-pressed="false">Games</button>
        <button class="filter-button" type="button" data-filter="daily" aria-pressed="false">Daily</button>
      </nav>
      <section class="timeline" aria-label="Dated entries">
        {% set yearGroups = collections.timeline | groupByYear %}
        {% if yearGroups.length %}
          {% for group in yearGroups %}
            <section class="year-group" data-year="{{ group.year }}">
              <h2 class="year-heading"><span>{{ group.year }}</span><span class="year-rule"></span></h2>
              {% for entry in group.entries %}
                <article class="timeline-entry">
                  <div class="entry-date"><time datetime="{{ entry.data.date }}">{{ entry.data.date }}</time>{% if entry.data.time %}<span>{{ entry.data.time }}</span>{% endif %}</div>
                  <div class="entry-main">
                    {% if entry.data.title != group.year %}<div class="entry-heading"><h3>{{ entry.data.title }}</h3></div>{% endif %}
                    {% if entry.data.images.length %}
                      <div class="image-grid">
                        {% for image in entry.data.images %}
                          {% set imageUrl = image.src | imageUrl | url %}
                          <figure class="timeline-image" data-category="{{ image.category }}">
                            <button class="image-open" type="button" data-src="{{ imageUrl }}" data-alt="{{ image.alt }}" data-caption="{{ image.caption }}" data-date="{{ image.date }}" aria-label="View image: {{ image.alt }}">
                              <img src="{{ imageUrl }}" alt="{{ image.alt }}" loading="lazy">
                              <span class="zoom-indicator" aria-hidden="true">View image ↗</span>
                            </button>
                            <figcaption><span class="category-label category-{{ image.category }}">{{ image.category }}</span><br><time datetime="{{ image.date }}">{{ image.date }}</time>{% if image.time %}<span class="image-time"> · {{ image.time }}</span>{% endif %}<p>{{ image.caption }}</p></figcaption>
                            {% if image.tags.length %}<ul class="tag-list" aria-label="Tags">{% for tag in image.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
                          </figure>
                        {% endfor %}
                      </div>
                    {% endif %}
                    {% if entry.templateContent | trim %}<div class="entry-body">{{ entry.templateContent | safe }}</div>{% endif %}
                  </div>
                </article>
              {% endfor %}
            </section>
          {% endfor %}
          <p class="filter-empty" hidden>No entries in this category yet.</p>
        {% else %}
          <div class="empty-state">
            <span class="empty-mark" aria-hidden="true">✳</span>
            <h2>Your timeline starts here.</h2>
            <p>There are no published entries yet. Add a dated Markdown file under <code>src/content/entries/</code> to begin.</p>
          </div>
        {% endif %}
      </section>
    </main>
    <footer class="site-footer"><span>Personal Archive</span><span>人活着是为了色小偶像</span></footer>
    <dialog class="lightbox" aria-label="Image viewer">
      <form method="dialog"><button class="lightbox-close" aria-label="Close image viewer">Close <span aria-hidden="true">×</span></button></form>
      <img class="lightbox-image" alt="">
      <div class="lightbox-caption"><time></time><p></p></div>
    </dialog>
  </body>
</html>
